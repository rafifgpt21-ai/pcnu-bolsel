// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum PostStatus {
  DRAFT      @map("Draft")
  IN_REVIEW  @map("InReview")
  SCHEDULED  @map("Scheduled")
  PUBLISHED  @map("Published")
  ARCHIVED   @map("Archived")
}

enum PostActivityType {
  CREATED
  AUTOSAVED
  SAVED
  SUBMITTED
  RETURNED
  PUBLISHED
  SCHEDULED
  SCHEDULE_CANCELLED
  UNPUBLISHED
  RESTORED
  DELETED
}

model User {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  username      String?         @unique
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role            @default(USER)
  accounts      Account[]
  sessions      Session[]
  authoredPosts Post[]         @relation("PostAuthor")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  slug                String      @unique
  excerpt             String?
  category            String      @default("Berita")
  tags                String[]    @default([])
  status              PostStatus  @default(DRAFT)
  thumbnail           String?
  blocks              Block[]
  sourceTitle         String?
  sourceUrl           String?
  seoTitle            String?
  seoDescription      String?
  authorId            String?     @db.ObjectId
  authorName          String      @default("PCNU Redaksi")
  lastEditedById      String?     @db.ObjectId
  lastEditedByName    String?
  version             Int         @default(1)
  reviewNote          String?
  submittedAt         DateTime?
  firstPublishedAt    DateTime?
  publishedAt         DateTime?
  scheduledAt         DateTime?
  publishedRevisionId String?     @db.ObjectId
  scheduledRevisionId String?     @db.ObjectId

  author     User?          @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  revisions  PostRevision[] @relation("PostRevisions")
  activities PostActivity[] @relation("PostActivities")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([publishedRevisionId])
  @@index([scheduledAt])
}

model PostRevision {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  version   Int
  snapshot  Json
  mediaUrls String[] @default([])
  reason    String
  actorId   String?  @db.ObjectId
  actorName String
  createdAt DateTime @default(now())

  post Post @relation("PostRevisions", fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, version])
  @@index([postId, createdAt])
}

model PostActivity {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  postId     String           @db.ObjectId
  type       PostActivityType
  actorId    String?          @db.ObjectId
  actorName  String
  fromStatus PostStatus?
  toStatus   PostStatus?
  note       String?
  createdAt  DateTime         @default(now())

  post Post @relation("PostActivities", fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

type Block {
  id       String
  type     String // 'text', 'image', 'video', 'pdf', 'link'
  content  String
  url      String?
  title    String?
  caption  String?
  altText  String?
  isLocked Boolean? @default(false)
}

model RateLimit {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String   @unique // Bisa berupa IP Address, Email, atau kombinasi keduanya
  attempts   Int      @default(1)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt]) // Indeks ini akan berguna untuk cleanup
}
